NEXT_CARD_PUSH_VAPID_SUBJECT=mailto:admin@example.com
NEXT_CARD_PUSH_VAPID_PUBLIC_KEY=
NEXT_CARD_PUSH_VAPID_PRIVATE_KEY=
NEXT_CARD_PUSH_SUBSCRIPTIONS_FILE=
NEXT_CARD_PUSH_TTL_SECONDS=3600

NEXT_CARD_CALENDAR_DIR=
NEXT_CARD_CALENDAR_NAME=Next Card
NEXT_CARD_CALENDAR_PRODUCT_ID=next-card/ics
NEXT_CARD_CALENDAR_DEFAULT_DURATION_MINUTES=25

MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_PLANNER_MODEL=mimo-v2.5-pro
MIMO_MULTIMODAL_MODEL=mimo-v2.5
MIMO_TIMEOUT_MS=30000
NEXT_CARD_AI_STRICT=false

# Optional chat-compat provider imported from the DeepSeek fork.
# Default chat route provider is Mimo Plan Mode; set this to deepseek to prefer DeepSeek.
NEXT_CARD_CHAT_PROVIDER=mimo
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
